# Copy to terraform.tfvars (gitignored) and adjust if needed.
# No secrets go here — mailbox creds + bearer tokens live in Secrets Manager,
# populated out of band (see deploy/README.md).

aws_region        = "us-east-1"
domain_name       = "mcp.samdavid.email"
route53_zone_name = "samdavid.email"
profiles          = ["dva"]
