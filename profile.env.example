# Template for a mailbox profile.
# Copy to ~/.config/email-mcp/<name>.env (e.g. dva.env), then register a project
# with MAIL_PROFILE=<name>. Profiles live OUTSIDE this repo so one install can
# serve many mailboxes — nothing here ever holds a credential.
#
# Use an APP-SPECIFIC PASSWORD where your provider supports it, not your main
# account password (e.g. Zoho: Settings → Security → App Passwords → Generate).

MAIL_EMAIL=you@example.com
MAIL_PASSWORD=

# Optional display name on outgoing mail
MAIL_FROM_NAME=

# Optional: send as a verified alias while still authenticating as MAIL_EMAIL.
# Defaults to MAIL_EMAIL if unset. (e.g. sam@yourdomain.com added as an alias.)
MAIL_FROM_ADDRESS=

# Host defaults are Zoho. For other providers:
#   Gmail:    imap.gmail.com / smtp.gmail.com
#   Fastmail: imap.fastmail.com / smtp.fastmail.com
#   Zoho custom-domain accounts often use the "pro" hosts below; if login fails,
#   try the standard hosts: imap.zoho.com / smtp.zoho.com
MAIL_IMAP_HOST=imappro.zoho.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtppro.zoho.com
MAIL_SMTP_PORT=465

# Safety: when "true", send_email returns a preview instead of actually sending.
MAIL_DRY_RUN=true
